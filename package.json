{
  "name": "flyingfish",
  "private": true,
  "workspaces": [
    "src/frontend",
    "src/api",
    "src/relay"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "stage:api": "node scripts/stage-api.mjs",
    "stage:batch": "node scripts/stage-api.mjs batch",
    "check:secrets": "node scripts/check-secrets.mjs src/frontend/dist src/api/dist src/relay/dist",
    "stage:relay": "node scripts/stage-api.mjs relay"
  },
  "devDependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.15 <25"
  }
}
