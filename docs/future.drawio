        </mxCell>
        <mxCell id="rbac" value="&lt;b&gt;マネージド ID の権限 (最小化)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;u&gt;API 用 MI&lt;/u&gt;&lt;br&gt;・Cosmos DB データ共同作成者&lt;br&gt;　→ DB / コンテナー単位に限定&lt;br&gt;・Storage Blob Data Contributor&lt;br&gt;　→ コンテナー単位に限定&lt;br&gt;・Functions 用 Storage: 必要ロールのみ&lt;br&gt;&lt;br&gt;&lt;u&gt;ワーカー用 MI (オプション)&lt;/u&gt;&lt;br&gt;・ジョブに必要な範囲のみ付与&lt;br&gt;&lt;br&gt;管理者操作・削除・手動ジョブは&lt;br&gt;通常利用者のロールから分離" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1690" y="960" width="260" height="310" as="geometry" />
        </mxCell>

