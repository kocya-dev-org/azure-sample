        <!-- ===== 凡例・RBAC ===== -->
        <mxCell id="legend" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;&lt;br&gt;[新規] note.md により追加&lt;br&gt;[変更] 既存リソースの設定変更&lt;br&gt;[オプション] 要件発生時に追加 (淡色・破線)&lt;br&gt;&lt;br&gt;━ 青: 利用者リクエスト&lt;br&gt;━ 緑: プライベート通信&lt;br&gt;┅ 紫: 認証 / トークン&lt;br&gt;&lt;br&gt;&lt;b&gt;廃止される経路&lt;/b&gt;&lt;br&gt;・ブラウザー → Function App 直接&lt;br&gt;・SWA → Function App (BYOF リンク)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;arcSize=4;" vertex="1" parent="1">
