          <mxGeometry x="240" y="430" width="50" height="50" as="geometry" />
        </mxCell>

        <!-- ===== アプリ ===== -->
        <mxCell id="swa" value="&lt;b&gt;Static Web Apps&lt;/b&gt;&lt;br&gt;swa-flyingfish-* (Standard)&lt;br&gt;[変更] 認証必須ルート定義&lt;br&gt;[変更] BYOF 直接リンクを廃止&lt;br&gt;Front Door 経由のみ受付" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/preview/Static_Apps.svg;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="430" y="180" width="56" height="56" as="geometry" />
        </mxCell>
        <mxCell id="apim" value="&lt;b&gt;[新規] API Management&lt;/b&gt;&lt;br&gt;JWT 検証 (集中)&lt;br&gt;利用者 / テナント単位の&lt;br&gt;レート制限・クォータ&lt;br&gt;Front Door 経由のみ許可" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/integration/API_Management_Services.svg;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="710" y="430" width="50" height="46" as="geometry" />
        </mxCell>
        <mxCell id="funcApi" value="&lt;b&gt;Function App (API)&lt;/b&gt;&lt;br&gt;func-flex-* / FC1 / Node.js&lt;br&gt;[変更] トークン検証・テナント認可&lt;br&gt;[変更] ページング・入力上限&lt;br&gt;[変更] 直接アクセス禁止&lt;br&gt;専用マネージド ID (最小権限)" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;image=img/lib/azure2/compute/Function_Apps.svg;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="960" y="210" width="56" height="50" as="geometry" />
        </mxCell>
        <mxCell id="funcWorker" value="&lt;b&gt;[オプション] Function App (ワーカー)&lt;/b&gt;&lt;br&gt;定期 / 手動ジョブ実行&lt;br&gt;API と分離した専用 MI&lt;br&gt;Cosmos / Blob へ PE 経由" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;image=img/lib/azure2/compute/Function_Apps.svg;verticalLabelPosition=bottom;verticalAlign=top;opacity=60;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="960" y="480" width="56" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fw" value="&lt;b&gt;[オプション] Azure Firewall&lt;/b&gt;&lt;br&gt;統合サブネットの送信を UDR で集約&lt;br&gt;FQDN ベースの送信先制限 / 脅威検知" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;image=img/lib/azure2/networking/Firewalls.svg;verticalLabelPosition=bottom;verticalAlign=top;opacity=60;fontColor=#666666;" vertex="1" parent="1">
