<mxfile host="app.diagrams.net">
  <diagram id="flyingfish-architecture" name="Flyingfish アーキテクチャ">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Flyingfish アーキテクチャ (infra/main.bicep)&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="30" width="700" height="36" as="geometry" />
        </mxCell>
        <mxCell id="user" value="利用者 (ブラウザー)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="310" width="50" height="80" as="geometry" />
        </mxCell>
        <mxCell id="swa" value="&lt;b&gt;Azure Static Web Apps&lt;/b&gt;&lt;br&gt;Free プラン&lt;br&gt;グローバル配信&lt;br&gt;Managed Functions: Node.js 22 / East Asia&lt;br&gt;HTTP トリガー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="250" width="270" height="190" as="geometry" />
        </mxCell>
        <mxCell id="cosmos" value="&lt;b&gt;Azure Cosmos DB for NoSQL&lt;/b&gt;&lt;br&gt;Japan East&lt;br&gt;Free Tier / 400 RU/s&lt;br&gt;Public network access&lt;br&gt;Connection string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="150" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="storage" value="&lt;b&gt;Azure Blob Storage&lt;/b&gt;&lt;br&gt;Japan East / Standard_LRS&lt;br&gt;Public network access&lt;br&gt;Private container: objects&lt;br&gt;Connection string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="390" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="settings" value="SWA API application settings&lt;br&gt;COSMOS_CONNECTION_STRING&lt;br&gt;BLOB_CONNECTION_STRING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="210" y="540" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="edge_user_swa" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#0078D4;" edge="1" parent="1" source="user" target="swa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_swa_cosmos" value="HTTPS / SQL API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#107C10;" edge="1" parent="1" source="swa" target="cosmos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_swa_storage" value="HTTPS / Blob API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#107C10;" edge="1" parent="1" source="swa" target="storage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_settings" value="デプロイ時に Azure CLI で設定" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#D6B656;fontSize=11;" edge="1" parent="1" source="settings" target="swa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
