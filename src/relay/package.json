    "dev": "npm run build && node dist/src/server.js"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12 <25"
  }
}
