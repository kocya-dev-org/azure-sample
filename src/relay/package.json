{
  "name": "flyingfish-relay",
  "version": "1.0.0",
  "private": true,
  "description": "Flyingfish 音声会話の中継（App Service、ADR 0013）",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
